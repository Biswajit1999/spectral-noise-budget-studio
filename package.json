{
  "name": "spectral-noise-budget-studio",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit --project tsconfig.app.json && vite build",
    "evidence": "tsx scripts/build_evidence.ts",
    "evidence:check": "tsx scripts/build_evidence.ts --check",
    "test": "vitest run",
    "check": "npm run evidence:check && npm run lint && npm run test && npm run build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "oxlint": "1.15.0",
    "tsx": "4.23.13",
    "typescript": "~5.7.2",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  }
}
